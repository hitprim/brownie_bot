# Telegram
BOT_TOKEN=
WEBHOOK_SECRET=

# Base URL (Railway даёт автоматически, или Cloudflare домен)
BASE_URL=https://domovoy.example.com

# Database (Railway даёт автоматически при добавлении PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/domovoy

# AI Providers
GROQ_API_KEY=
OPENROUTER_API_KEY=

# LLM модели (через OpenRouter)
LLM_MODEL=deepseek/deepseek-chat
LLM_FALLBACK_MODEL=anthropic/claude-3.5-haiku

# Optional: трейсинг
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=domovoy
LANGCHAIN_TRACING_V2=false

# Config
DEBUG=false
LOG_LEVEL=INFO
